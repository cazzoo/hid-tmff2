/* T500RS packet structures based on captured USB traffic */
struct __packed t500rs_packet_header {
    u8 cmd;
    u8 id;
    u8 code;
};

struct __packed t500rs_packet_envelope {
    u16 attack_length;
    u16 attack_level;
    u16 fade_length;
    u16 fade_level;
};

struct __packed t500rs_packet_effect {
    struct t500rs_packet_header header;
    u16 magnitude;
    u16 offset;
    u16 phase;
    u16 period;
    struct t500rs_packet_envelope envelope;
};

/* Device data structure */
struct t500rs_device_entry {
    struct hid_device *hdev;
    struct hid_report *report;
    struct hid_field *ff_field;
    struct usb_device *usbdev;
    size_t buffer_length;
};

struct t500rs_condition_data {
    u16 left_saturation;
    u16 right_saturation;
    u16 left_coeff;
    u16 right_coeff;
    u16 deadband;
    s16 center;
};

/* Function prototypes */
int t500rs_populate_api(struct tmff2_device_entry *tmff2);
static int t500rs_upload_constant(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_upload_ramp(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_upload_spring(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_upload_condition(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_upload_periodic(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);

static int t500rs_update_constant(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_update_ramp(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_update_spring(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_update_condition(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);
static int t500rs_update_periodic(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state);

/* Effect types from observed USB traffic */
enum t500rs_effect_types {
    T500RS_EFFECT_CONSTANT = 0x00,
    T500RS_EFFECT_SPRING = 0x40,
    T500RS_EFFECT_DAMPER = 0x41,
    T500RS_EFFECT_FRICTION = 0x41,
    T500RS_EFFECT_SINE = 0x21,
    T500RS_EFFECT_TRIANGLE = 0x22,
    T500RS_EFFECT_SAWTOOTH_UP = 0x23,
    T500RS_EFFECT_SAWTOOTH_DOWN = 0x24,
};

#define MAX_DIRECTION_RATIO  100
#define MAX_SATURATION      10000
#define MAX_COEFFICIENT     10000
#define MAX_DEADBAND        10000
#define MAX_CENTER          10000

#endif /* __HID_TMT500RS_H */