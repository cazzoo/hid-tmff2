#ifndef __HID_TMT500RS_H
#define __HID_TMT500RS_H

#include "../hid-tmff2.h"

#define T500RS_BUFFER_LENGTH 64
#define T500RS_CMD_HEADER_SIZE 8
#define USB_VENDOR_ID_THRUSTMASTER 0x044f
#define USB_DEVICE_ID_THRUSTMASTER_T500RS 0xb65e

