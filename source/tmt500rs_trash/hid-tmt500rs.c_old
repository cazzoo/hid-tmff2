#include <linux/hid.h>
#include <linux/usb.h>
#include "hid-tmt500rs.h"

/* Command header from captured packets */
static const u8 t500rs_cmd_header[T500RS_CMD_HEADER_SIZE] = {
    0x1c, 0x00, 0x20, 0x7b, 0x3b, 0x01, 0x8f, 0xe3};

/* Forward declarations */
static int t500rs_init_device(struct t500rs_device_entry *t500rs);
static int t500rs_play_effect(struct t500rs_device_entry *t500rs, int effect_id, int value);
static int t500rs_send_buf(struct t500rs_device_entry *t500rs, u8 *send_buffer, size_t len);

/* Check for firmware version like T300RS does */
static int t500rs_check_firmware(struct t500rs_device_entry *t500rs)
{
    struct usb_interface *usbif = to_usb_interface(t500rs->hdev->dev.parent);
    struct usb_device *usbdev = interface_to_usbdev(usbif);
    int ret;
    u8 *buf;

    buf = kmalloc(8, GFP_KERNEL);
    if (!buf)
        return -ENOMEM;

    ret = usb_control_msg(usbdev, usb_rcvctrlpipe(usbdev, 0),
                          USB_REQ_CLEAR_FEATURE,
                          USB_TYPE_CLASS | USB_RECIP_INTERFACE | USB_DIR_IN,
                          0x0300, 0,
                          buf, 8,
                          USB_CTRL_SET_TIMEOUT);

    if (ret < 0)
    {
        hid_err(t500rs->hdev, "Failed to get firmware version\n");
        kfree(buf);
        return ret;
    }

    /* T500RS response format matches tm_wheel_response */
    if (buf[2] != 0x02)
    { // 0x02 is expected model for T500RS
        hid_err(t500rs->hdev, "Unexpected wheel model: %02x\n", buf[2]);
        kfree(buf);
        return -EINVAL;
    }

    kfree(buf);
    return 0;
}

static int t500rs_send_buf(struct t500rs_device_entry *t500rs, u8 *send_buffer, size_t len)
{
    int i;
    if (len > t500rs->buffer_length)
        return -EINVAL;

    /* Fill with actual data */
    for (i = 0; i < len; ++i)
        t500rs->ff_field->value[i] = send_buffer[i];

    /* Fill rest with zeros */
    for (i = len; i < t500rs->buffer_length; ++i)
        t500rs->ff_field->value[i] = 0;

    hid_hw_request(t500rs->hdev, t500rs->report, HID_REQ_SET_REPORT);
    return 0;
}

// Change from t500rs_set_gain(struct t500rs_device_entry *t500rs, u16 gain)
static int t500rs_set_gain(struct t500rs_device_entry *t500rs, uint16_t gain)
{
    u8 buf[T500RS_BUFFER_LENGTH] = {0};

    /* FF_GAIN command format */
    buf[0] = 0x60;
    buf[1] = 0x02;
    buf[2] = gain;

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

// Change from t500rs_set_autocenter(struct t500rs_device_entry *t500rs, u16 center)
static int t500rs_set_autocenter(struct t500rs_device_entry *t500rs, uint16_t center)
{
    u8 buf[T500RS_BUFFER_LENGTH] = {0};

    /* FF_AUTOCENTER command format */
    buf[0] = 0x60;
    buf[1] = 0x08;
    buf[2] = 0x03;
    buf[3] = center & 0xFF;
    buf[4] = (center >> 8) & 0xFF;

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_play_effect(struct t500rs_device_entry *t500rs, int effect_id, int value)
{
    u8 buf[T500RS_BUFFER_LENGTH];

    memcpy(buf, t500rs_cmd_header, T500RS_CMD_HEADER_SIZE);
    buf[8] = effect_id;
    buf[9] = value ? 0x41 : 0x00;  // Play/Stop command
    buf[10] = value ? 0x01 : 0x00; // Effect state

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

int t500rs_upload_effect(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    switch (state->effect.type)
    {
    case FF_CONSTANT:
        return t500rs_upload_constant(t500rs, state);
    case FF_RAMP:
        return t500rs_upload_ramp(t500rs, state);
    case FF_SPRING:
        return t500rs_upload_spring(t500rs, state);
    case FF_DAMPER:
    case FF_FRICTION:
    case FF_INERTIA:
        return t500rs_upload_condition(t500rs, state);
    case FF_PERIODIC:
        return t500rs_upload_periodic(t500rs, state);
    default:
        hid_err(t500rs->hdev, "invalid effect type: %x", state->effect.type);
        return -1;
    }
}

int t500rs_update_effect(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    switch (state->effect.type)
    {
    case FF_CONSTANT:
        return t500rs_update_constant(t500rs, state);
    case FF_RAMP:
        return t500rs_update_ramp(t500rs, state);
    case FF_SPRING:
        return t500rs_update_spring(t500rs, state);
    case FF_DAMPER:
    case FF_FRICTION:
    case FF_INERTIA:
        return t500rs_update_condition(t500rs, state);
    case FF_PERIODIC:
        return t500rs_update_periodic(t500rs, state);
    default:
        hid_err(t500rs->hdev, "invalid effect type: %x", state->effect.type);
        return -1;
    }
}

static int t500rs_update_condition(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect effect = state->effect;
	struct ff_effect old = state->old;
	struct ff_condition_effect cond = effect.u.condition[0];
	struct ff_condition_effect cond_old = old.u.condition[0];
    struct t500rs_device_data *t500rs_data = ff->private;
    struct t500rs_condition_data condition_data;
    int direction_ratio;

        /* Calculate direction ratio (-100% to +100%) */
    if (effect->direction < 0)
        direction_ratio = -MAX_DIRECTION_RATIO;
    else if (effect->direction > 0)
        direction_ratio = MAX_DIRECTION_RATIO;
    else
        direction_ratio = 0;

    /* Send condition data to device */
    return t500rs_send_condition(t500rs_data->udev, 
                               effect->id,
                               direction_ratio,
                               &condition_data);
}
    /* Send condition data to device */
    return t500rs_send_condition(t500rs_data->udev, 
                               effect->id,
                               direction_ratio,
                               &condition_data);
}
    /* Send condition data to device */
    return t500rs_send_condition(t500rs_data->udev, 
                               effect->id,
                               direction_ratio,
                               &condition_data);
}

static int t500rs_upload_constant(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_constant_effect *constant = &effect->u.constant;
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int level;

    /* Format based on captured constant effect:
       02 1c 00 00 00 00 00 00 00
       03 0e 00 00
       01 00 00 40 69 23 00 ff ff 0e 00 1c 00 00 00 */

    /* First packet - setup */
    buf[0] = 0x02;
    buf[1] = 0x1c;

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Second packet - level */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x03;
    buf[1] = 0x0e;

    /* Convert level to T500RS format */
    level = constant->level;
    if (level < 0)
        buf[2] = 0xed; // Negative force
    else if (level > 0)
        buf[2] = 0x40; // Positive force
    else
        buf[2] = 0xff; // No force

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Third packet - envelope and timing */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x01;
    buf[1] = 0x00;
    buf[2] = 0x00;
    buf[3] = 0x40;
    buf[4] = effect->replay.length & 0xFF;
    buf[5] = (effect->replay.length >> 8) & 0xFF;

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_upload_ramp(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_ramp_effect *ramp = &effect->u.ramp;
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int ret;

    /* Format based on captured ramp effect:
       02 1c 00 00 00 00 00 00 00
       04 0e 00 00 00 00 69 23
       01 00 24 40 69 23 00 ff ff 0e 00 1c 00 00 00 */

    /* First packet - setup */
    buf[0] = 0x02;
    buf[1] = 0x1c;

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Second packet - ramp parameters */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x04;
    buf[1] = 0x0e;
    /* Start and end levels mapped to T500RS range */
    buf[2] = (ramp->start_level >> 8) & 0xFF;
    buf[3] = (ramp->end_level >> 8) & 0xFF;
    buf[6] = effect->replay.length & 0xFF;
    buf[7] = (effect->replay.length >> 8) & 0xFF;

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Third packet - envelope and timing */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x01;
    buf[1] = 0x00;
    buf[2] = 0x24; // Ramp effect type
    buf[3] = 0x40; // Effect modifier
    buf[4] = effect->replay.length & 0xFF;
    buf[5] = (effect->replay.length >> 8) & 0xFF;
    /* Add envelope parameters */
    if (ramp->envelope.attack_length || ramp->envelope.fade_length)
    {
        buf[6] = ramp->envelope.attack_length & 0xFF;
        buf[7] = (ramp->envelope.attack_length >> 8) & 0xFF;
        buf[8] = ramp->envelope.fade_length & 0xFF;
        buf[9] = (ramp->envelope.fade_length >> 8) & 0xFF;
    }

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_upload_spring(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_condition_effect *condition = &effect->u.condition[0];
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int ret;

    /* Format based on captured spring effect:
       05 0e 00 64 64 00 00 00 00 54 54
       05 1c 00 00 00 00 00 00 00 46 54
       01 00 40 40 17 25 00 ff ff 0e 00 1c 00 00 00 */

    /* First packet - spring parameters */
    buf[0] = 0x05;
    buf[1] = 0x0e;
    /* Scale coefficients to T500RS range (0-100) */
    buf[3] = abs(condition->right_coeff) * 100 / 0x7fff;
    buf[4] = abs(condition->left_coeff) * 100 / 0x7fff;
    /* Deadband */
    buf[5] = condition->deadband * 100 / 0xffff;
    /* Center */
    buf[6] = condition->center * 100 / 0xffff;
    /* Saturation */
    buf[9] = 0x54;  // Right saturation
    buf[10] = 0x54; // Left saturation

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Second packet - additional parameters */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x05;
    buf[1] = 0x1c;
    /* Set coefficients signs */
    buf[9] = 0x46;  // Spring coefficient modifier
    buf[10] = 0x54; // Spring saturation

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Third packet - envelope and timing */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x01;
    buf[1] = 0x00;
    buf[2] = 0x40; // Spring effect type
    buf[3] = 0x40; // Effect modifier
    buf[4] = effect->replay.length & 0xFF;
    buf[5] = (effect->replay.length >> 8) & 0xFF;
    buf[8] = 0xff; // Effect specific parameter
    buf[9] = 0x0e; // Effect specific parameter

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_upload_damper(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_condition_effect *condition = &effect->u.condition[0];
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int ret;

    /* Format based on captured damper effect:
       05 0e 00 64 64 00 00 00 00 64 64
       05 1c 00 00 00 00 00 00 00 64 64
       01 00 41 40 17 25 00 ff ff 0e 00 1c 00 00 00 */

    /* First packet - damper parameters */
    buf[0] = 0x05;
    buf[1] = 0x0e;
    /* Scale coefficients to T500RS range (0-100) */
    buf[3] = abs(condition->right_coeff) * 100 / 0x7fff;
    buf[4] = abs(condition->left_coeff) * 100 / 0x7fff;
    /* Deadband */
    buf[5] = condition->deadband * 100 / 0xffff;
    /* Center */
    buf[6] = condition->center * 100 / 0xffff;
    /* Damper uses different saturation values than spring */
    buf[9] = 0x64;  // Right saturation
    buf[10] = 0x64; // Left saturation

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Second packet - additional parameters */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x05;
    buf[1] = 0x1c;
    /* Damper specific parameters */
    buf[9] = 0x64;  // Damper coefficient modifier
    buf[10] = 0x64; // Damper saturation

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Third packet - envelope and timing */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x01;
    buf[1] = 0x00;
    buf[2] = 0x41; // Damper effect type
    buf[3] = 0x40; // Effect modifier
    buf[4] = effect->replay.length & 0xFF;
    buf[5] = (effect->replay.length >> 8) & 0xFF;
    buf[8] = 0xff; // Effect specific parameter
    buf[9] = 0x0e; // Effect specific parameter

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_upload_friction(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_condition_effect *condition = &effect->u.condition[0];
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int ret;

    /* Format based on captured friction effect:
       05 0e 00 64 64 00 00 00 00 64 64
       05 1c 00 00 00 00 00 00 00 64 64
       01 00 41 40 17 25 00 ff ff 0e 00 1c 00 00 00 */

    /* First packet - friction parameters */
    buf[0] = 0x05;
    buf[1] = 0x0e;
    /* Scale coefficients to T500RS range (0-100) */
    buf[3] = abs(condition->right_coeff) * 100 / 0x7fff;
    buf[4] = abs(condition->left_coeff) * 100 / 0x7fff;
    /* Deadband */
    buf[5] = condition->deadband * 100 / 0xffff;
    /* Center */
    buf[6] = condition->center * 100 / 0xffff;
    /* Friction uses same saturation values as damper */
    buf[9] = 0x64;  // Right saturation
    buf[10] = 0x64; // Left saturation

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Second packet - additional parameters */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x05;
    buf[1] = 0x1c;
    /* Friction specific parameters */
    buf[9] = 0x64;  // Friction coefficient modifier
    buf[10] = 0x64; // Friction saturation

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Third packet - envelope and timing */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x01;
    buf[1] = 0x00;
    buf[2] = 0x41; // Friction effect type (same as damper but with different coefficients)
    buf[3] = 0x40; // Effect modifier
    buf[4] = effect->replay.length & 0xFF;
    buf[5] = (effect->replay.length >> 8) & 0xFF;
    /* Add envelope parameters if present */
    if (condition->envelope.attack_length || condition->envelope.fade_length)
    {
        buf[6] = condition->envelope.attack_length & 0xFF;
        buf[7] = (condition->envelope.attack_length >> 8) & 0xFF;
        buf[8] = condition->envelope.fade_length & 0xFF;
        buf[9] = (condition->envelope.fade_length >> 8) & 0xFF;
    }
    else
    {
        buf[8] = 0xff; // Default effect specific parameter
        buf[9] = 0x0e; // Default effect specific parameter
    }

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_init_device(struct t500rs_device_entry *t500rs)
{
    struct list_head *report_list = &t500rs->hdev->report_enum[HID_OUTPUT_REPORT].report_list;
    struct hid_report *report = list_entry(report_list->next, struct hid_report, list);

    if (!report)
    {
        hid_err(t500rs->hdev, "No output report found\n");
        return -ENODEV;
    }

    if (!report->field[0])
    {
        hid_err(t500rs->hdev, "No fields in the report\n");
        return -ENODEV;
    }

    t500rs->report = report;
    t500rs->ff_field = report->field[0];
    t500rs->buffer_length = T500RS_BUFFER_LENGTH;

    return t500rs_check_firmware(t500rs);
}

static int t500rs_upload_periodic(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_periodic_effect *periodic = &effect->u.periodic;
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    u8 waveform;
    int ret;

    /* Format based on captured periodic effect:
       02 1c 00 00 00 00 00 00 00
       04 0e 00 00 00 00 e8 03
       01 00 20 40 17 25 00 ff ff 0e 00 1c 00 00 00 */

    /* Map waveform type to T500RS codes */
    switch (periodic->waveform)
    {
    case FF_SINE:
        waveform = 0x20;
        break;
    case FF_SQUARE:
        waveform = 0x21;
        break;
    case FF_TRIANGLE:
        waveform = 0x22;
        break;
    case FF_SAW_UP:
        waveform = 0x23;
        break;
    case FF_SAW_DOWN:
        waveform = 0x24;
        break;
    default:
        hid_warn(t500rs->hdev, "Unsupported waveform %d, using sine\n",
                 periodic->waveform);
        waveform = 0x20;
        break;
    }

    /* First packet - setup */
    buf[0] = 0x02;
    buf[1] = 0x1c;

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Second packet - periodic parameters */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x04;
    buf[1] = 0x0e;
    /* Magnitude (amplitude) */
    buf[2] = (periodic->magnitude >> 8) & 0xFF;
    buf[3] = periodic->magnitude & 0xFF;
    /* Offset */
    buf[4] = (periodic->offset >> 8) & 0xFF;
    buf[5] = periodic->offset & 0xFF;
    /* Period */
    buf[6] = periodic->period & 0xFF;
    buf[7] = (periodic->period >> 8) & 0xFF;
    /* Phase */
    buf[8] = periodic->phase * 0xFF / 0x10000; // Scale phase to 0-255

    if ((ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH)))
        return ret;

    /* Third packet - envelope and timing */
    memset(buf, 0, T500RS_BUFFER_LENGTH);
    buf[0] = 0x01;
    buf[1] = 0x00;
    buf[2] = waveform; // Waveform type
    buf[3] = 0x40;     // Effect modifier
    buf[4] = effect->replay.length & 0xFF;
    buf[5] = (effect->replay.length >> 8) & 0xFF;

    /* Add envelope parameters if present */
    if (periodic->envelope.attack_length || periodic->envelope.fade_length)
    {
        buf[6] = periodic->envelope.attack_length & 0xFF;
        buf[7] = (periodic->envelope.attack_length >> 8) & 0xFF;
        buf[8] = periodic->envelope.fade_length & 0xFF;
        buf[9] = (periodic->envelope.fade_length >> 8) & 0xFF;
        buf[10] = periodic->envelope.attack_level;
        buf[11] = periodic->envelope.fade_level;
    }
    else
    {
        /* Default parameters when no envelope is specified */
        buf[8] = 0xff;
        buf[9] = 0x0e;
    }

    return t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
}

static int t500rs_update_ramp(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_ramp_effect *ramp = &effect->u.ramp;
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int ret;

    /* Format based on force-effects-t500.txt
       For ramp effect updates:
       04 0e 00 XX YY where XX is start level and YY is end level */
    
    buf[0] = 0x04;
    buf[1] = 0x0e;
    
    /* Start level */
    buf[2] = (ramp->start_level >> 8) & 0xFF;
    /* End level */
    buf[3] = (ramp->end_level >> 8) & 0xFF;
    
    /* Duration update if changed */
    if (effect->replay.length != state->old.replay.length) {
        buf[6] = effect->replay.length & 0xFF;
        buf[7] = (effect->replay.length >> 8) & 0xFF;
    }
    
    /* Envelope update if changed */
    if (ramp->envelope.attack_length != state->old.u.ramp.envelope.attack_length ||
        ramp->envelope.fade_length != state->old.u.ramp.envelope.fade_length) {
        buf[8] = ramp->envelope.attack_length & 0xFF;
        buf[9] = (ramp->envelope.attack_length >> 8) & 0xFF;
        buf[10] = ramp->envelope.fade_length & 0xFF;
        buf[11] = (ramp->envelope.fade_length >> 8) & 0xFF;
    }

    /* Send the update packet */
    ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
    if (ret)
        hid_err(t500rs->hdev, "Failed to update ramp effect\n");

    return ret;
}

static int t500rs_update_periodic(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_periodic_effect *periodic = &effect->u.periodic;
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int ret;

    /* Format based on force-effects-t500.txt
       For periodic effect updates:
       04 0e MM MM OO OO PP PP PH
       where:
       MM = magnitude
       OO = offset
       PP = period
       PH = phase */
    
    buf[0] = 0x04;
    buf[1] = 0x0e;
    
    /* Magnitude (amplitude) */
    buf[2] = (periodic->magnitude >> 8) & 0xFF;
    buf[3] = periodic->magnitude & 0xFF;
    
    /* Offset */
    buf[4] = (periodic->offset >> 8) & 0xFF;
    buf[5] = periodic->offset & 0xFF;
    
    /* Period */
    buf[6] = periodic->period & 0xFF;
    buf[7] = (periodic->period >> 8) & 0xFF;
    
    /* Phase - scale from 0-65535 to 0-255 */
    buf[8] = periodic->phase * 0xFF / 0x10000;

    /* Check if envelope parameters changed */
    if (periodic->envelope.attack_length != state->old.u.periodic.envelope.attack_length ||
        periodic->envelope.fade_length != state->old.u.periodic.envelope.fade_length ||
        periodic->envelope.attack_level != state->old.u.periodic.envelope.attack_level ||
        periodic->envelope.fade_level != state->old.u.periodic.envelope.fade_level) {
        
        /* Send additional packet for envelope update */
        u8 env_buf[T500RS_BUFFER_LENGTH] = {0};
        env_buf[0] = 0x01;
        env_buf[1] = 0x00;
        env_buf[2] = 0x20;  // Periodic effect type
        env_buf[3] = 0x40;  // Effect modifier
        env_buf[6] = periodic->envelope.attack_length & 0xFF;
        env_buf[7] = (periodic->envelope.attack_length >> 8) & 0xFF;
        env_buf[8] = periodic->envelope.fade_length & 0xFF;
        env_buf[9] = (periodic->envelope.fade_length >> 8) & 0xFF;
        env_buf[10] = periodic->envelope.attack_level;
        env_buf[11] = periodic->envelope.fade_level;
        
        ret = t500rs_send_buf(t500rs, env_buf, T500RS_BUFFER_LENGTH);
        if (ret) {
            hid_err(t500rs->hdev, "Failed to update periodic effect envelope\n");
            return ret;
        }
    }

    /* Send the main update packet */
    ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
    if (ret)
        hid_err(t500rs->hdev, "Failed to update periodic effect\n");

    return ret;
}

static int t500rs_update_constant(struct t500rs_device_entry *t500rs, struct tmff2_effect_state *state)
{
    struct ff_effect *effect = &state->effect;
    struct ff_constant_effect *constant = &effect->u.constant;
    u8 buf[T500RS_BUFFER_LENGTH] = {0};
    int level;
    int ret;

    /* Format based on force-effects-t500.txt
       For constant effect updates:
       03 0e 00 XX  where XX is the level */
    
    buf[0] = 0x03;
    buf[1] = 0x0e;
    
    /* Convert level to T500RS format */
    level = constant->level;
    if (level < 0)
        buf[2] = 0xed;  // Negative force
    else if (level > 0)
        buf[2] = 0x40;  // Positive force
    else
        buf[2] = 0xff;  // No force

    buf[3] = 0x00;

    /* Send the update packet */
    ret = t500rs_send_buf(t500rs, buf, T500RS_BUFFER_LENGTH);
    if (ret)
        hid_err(t500rs->hdev, "Failed to update constant force effect\n");

    return ret;
}



int t500rs_populate_api(struct tmff2_device_entry *tmff2)
{
    struct t500rs_device_entry *t500rs;
    int ret;

    t500rs = kzalloc(sizeof(*t500rs), GFP_KERNEL);
    if (!t500rs)
        return -ENOMEM;

    t500rs->hdev = tmff2->hdev;
    t500rs->usbdev = interface_to_usbdev(to_usb_interface(tmff2->hdev->dev.parent));

    ret = t500rs_init_device(t500rs);
    if (ret)
    {
        kfree(t500rs);
        return ret;
    }

    tmff2->data = t500rs;

    // Effect handlers
    tmff2->play_effect = t500rs_play_effect;
    tmff2->upload_effect = t500rs_upload_effect;
    tmff2->update_effect = t500rs_update_effect;
    tmff2->stop_effect = t500rs_stop_effect;

    // Device control
    tmff2->set_gain = t500rs_set_gain;
    tmff2->set_autocenter = t500rs_set_autocenter;
    tmff2->set_range = t500rs_set_range;

    // Features
    tmff2->params |= PARAM_GAIN | PARAM_RANGE |
                     PARAM_FRICTION_LEVEL | PARAM_SPRING_LEVEL |
                     PARAM_DAMPER_LEVEL;

    return 0;
}
