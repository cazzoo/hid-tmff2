# udev rules for Thrustmaster T500RS Racing Wheel
# This allows non-root users to access the wheel's sysfs attributes
#
# Installation:
#   sudo cp 99-thrustmaster-t500rs.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   Reconnect the wheel (or reboot)
#
# After installation, you can access wheel settings without sudo

# Thrustmaster T500RS (Product ID: 0xb65e, Vendor ID: 0x044f)
SUBSYSTEM=="hid", ATTRS{idVendor}=="044f", ATTRS{idProduct}=="b65e", MODE="0666", TAG+="uaccess"

# Alternative: Add to input group (more restrictive)
# SUBSYSTEM=="hid", ATTRS{idVendor}=="044f", ATTRS{idProduct}=="b65e", MODE="0660", GROUP="input"

